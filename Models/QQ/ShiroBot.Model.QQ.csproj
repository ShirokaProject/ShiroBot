<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.9.0</Version>
        <AssemblyVersion>0.9.0.0</AssemblyVersion>
        <FileVersion>0.9.0.0</FileVersion>
        <EnablePackageValidation>true</EnablePackageValidation>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>ShiroBot.Model.QQ</AssemblyName>
        <RootNamespace>ShiroBot.Model.QQ</RootNamespace>
        <Description>Protocol-neutral QQ platform model and extension API contracts for ShiroBot adapters and plugins.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <ShiroBotPluginPackagingEnabled>false</ShiroBotPluginPackagingEnabled>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SDK\ShiroBot.SDK.csproj" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
