<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>$(ShiroBotProductVersion)</Version>
        <AssemblyVersion>$(ShiroBotTelegramModelAbiVersion)</AssemblyVersion>
        <FileVersion>$(ShiroBotFileVersion)</FileVersion>
        <EnablePackageValidation>true</EnablePackageValidation>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>ShiroBot.Model.Telegram</AssemblyName>
        <RootNamespace>ShiroBot.Model.Telegram</RootNamespace>
        <Description>Protocol-neutral Telegram platform model contracts for ShiroBot adapters and plugins.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <ShiroBotPluginPackagingEnabled>false</ShiroBotPluginPackagingEnabled>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SDK\ShiroBot.SDK.csproj" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
