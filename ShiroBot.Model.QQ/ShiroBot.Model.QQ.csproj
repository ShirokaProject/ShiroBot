<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.8.0</Version>
        <AssemblyVersion>0.8.0.0</AssemblyVersion>
        <FileVersion>0.8.0.0</FileVersion>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion Condition="'$(PackageValidationBaselineVersion)' == '' and '$(Version)' != '0.8.0'">0.8.0</PackageValidationBaselineVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>ShiroBot.Model.QQ</AssemblyName>
        <RootNamespace>ShiroBot.Model.QQ</RootNamespace>
        <Description>Protocol-neutral QQ platform model and extension API contracts for ShiroBot adapters and plugins.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <ShiroBotPluginPackagingEnabled>false</ShiroBotPluginPackagingEnabled>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ShiroBot.SDK\ShiroBot.SDK.csproj" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <Target Name="CopyModelToHost"
            AfterTargets="Build"
            Condition="'$(Configuration)'=='Debug'">
        <PropertyGroup>
            <HostModelDir>$(MSBuildProjectDirectory)\..\ShiroBot\bin\Debug\$(TargetFramework)\models\</HostModelDir>
        </PropertyGroup>
        <MakeDir Directories="$(HostModelDir)" />
        <Delete Files="$(HostModelDir)ShiroBot.QQ.dll;$(HostModelDir)ShiroBot.QQ.pdb" />
        <Copy SourceFiles="$(TargetPath);$(TargetDir)$(AssemblyName).pdb"
              DestinationFiles="$(HostModelDir)$(AssemblyName).dll;$(HostModelDir)$(AssemblyName).pdb"
              SkipUnchangedFiles="true"
              Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
        <Copy SourceFiles="$(TargetPath)"
              DestinationFiles="$(HostModelDir)$(AssemblyName).dll"
              SkipUnchangedFiles="true"
              Condition="!Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </Target>

</Project>
