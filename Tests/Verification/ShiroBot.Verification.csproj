<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../Templates/Examples/DashboardWeb/Web/index.html" LogicalName="test-web/index.html" />
    <ProjectReference Include="..\..\Core\ShiroBot.csproj" />
    <ProjectReference Include="..\..\SDK\ShiroBot.SDK.csproj" />
    <ProjectReference Include="..\SharedContractPluginProbe\ShiroBot.SharedContractPluginProbe.csproj" />
    <ProjectReference Include="../ExternalConfigPluginProbe/ShiroBot.ExternalConfigPluginProbe.csproj" />
