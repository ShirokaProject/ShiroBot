<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ShiroBot.SDK</PackageId>
    <Version>$(ShiroBotProductVersion)</Version>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ShiroBotPluginPackagingEnabled>false</ShiroBotPluginPackagingEnabled>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>ShirokaProject</Authors>
    <Description>Core SDK and built-in platform contracts for ShiroBot plugins and adapters.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageTags>ShiroBot;bot;sdk;plugin;adapter;QQ;Discord;Telegram;Avalonia;rendering</PackageTags>
    <PackageProjectUrl>https://github.com/ShirokaProject/ShiroBot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShirokaProject/ShiroBot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>$(ShiroBotProductVersion) adds plugin and adapter lifetime scopes, named JSON services and the plugin event bus. The SDK includes the [PluginContract]/[PluginJson] source generator: callers import a provider DLL at build time, with no shared contract assembly at runtime. Plugins register authenticated Dashboard component pages through IBotContext.Dashboard; the host renders component trees, validates forms and declared actions, and handles uploads and files. AddWebPage registers embedded self-contained HTML in an opaque-origin sandbox with a page-scoped authenticated bridge. Breaking change: IPluginServices no longer inherits IServiceProvider; RegisterSingleton&lt;T&gt;, GetService&lt;T&gt; and GetRequiredService&lt;T&gt; are removed. Consumers of those APIs must migrate to named JSON services or generated contracts and rebuild. SDK ABI $(ShiroBotSdkAbiVersion); QQ Model ABI $(ShiroBotQqModelAbiVersion), Discord Model ABI $(ShiroBotDiscordModelAbiVersion), Telegram Model ABI $(ShiroBotTelegramModelAbiVersion). These APIs require host $(ShiroBotProductVersion).</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5104;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShiroBot.SDK.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Generators\ShiroBot.SDK.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\Models\Discord\ShiroBot.Model.Discord.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\Models\QQ\ShiroBot.Model.QQ.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\Models\Telegram\ShiroBot.Model.Telegram.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Skia" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\buildTransitive\ShiroBot.SDK.props" Pack="true" PackagePath="buildTransitive\ShiroBot.SDK.props" />
    <None Include="..\buildTransitive\ShiroBot.SDK.targets" Pack="true" PackagePath="buildTransitive\ShiroBot.SDK.targets" />
    <None Include="$(PkgILRepack_Lib_MSBuild_Task)\build\ILRepack.Lib.MSBuild.Task.dll" Pack="true" PackagePath="tools\ILRepack.Lib.MSBuild.Task.dll" Visible="false" />
    <None Include="..\bin\$(Configuration)\$(TargetFramework)\ShiroBot.SDK.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Generators\bin\$(Configuration)\netstandard2.0\ShiroBot.SDK.Generators.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
    <None Include="..\..\Models\Discord\bin\$(Configuration)\$(TargetFramework)\ShiroBot.Model.Discord.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\..\Models\QQ\bin\$(Configuration)\$(TargetFramework)\ShiroBot.Model.QQ.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\..\Models\Telegram\bin\$(Configuration)\$(TargetFramework)\ShiroBot.Model.Telegram.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
  </ItemGroup>

</Project>
