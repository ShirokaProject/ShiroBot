<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ShiroBot.SDK</PackageId>
    <Version>$(ShiroBotProductVersion)</Version>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ShiroBotPluginPackagingEnabled>false</ShiroBotPluginPackagingEnabled>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>ShirokaProject</Authors>
    <Description>Core SDK and built-in platform contracts for ShiroBot plugins and adapters.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageTags>ShiroBot;bot;sdk;plugin;adapter;QQ;Discord;Telegram;Avalonia;rendering</PackageTags>
    <PackageProjectUrl>https://github.com/ShirokaProject/ShiroBot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShirokaProject/ShiroBot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>0.9.9 adds optional common file uploads (IFileService, FileUploadRequest/FileUploadResult, SentMessage.UploadedFile), scoped upload routing, improved development templates and Avalonia previewer opt-in evaluation. SDK ABI 1.1 is compatible with SDK ABI 1.0 components; new ABI 1.1 components require host 0.9.9 or newer. QQ Model ABI remains 1.0. ABI: SDK $(ShiroBotSdkAbiVersion), QQ Model $(ShiroBotQqModelAbiVersion), Discord Model $(ShiroBotDiscordModelAbiVersion), Telegram Model $(ShiroBotTelegramModelAbiVersion); ShiroBot API 0.9.2.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5104;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SDK\ShiroBot.SDK.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\Models\Discord\ShiroBot.Model.Discord.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\Models\QQ\ShiroBot.Model.QQ.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\Models\Telegram\ShiroBot.Model.Telegram.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Skia" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\SDK\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\SDK\buildTransitive\ShiroBot.SDK.props" Pack="true" PackagePath="buildTransitive\ShiroBot.SDK.props" />
    <None Include="..\..\SDK\buildTransitive\ShiroBot.SDK.targets" Pack="true" PackagePath="buildTransitive\ShiroBot.SDK.targets" />
    <None Include="$(PkgILRepack_Lib_MSBuild_Task)\build\ILRepack.Lib.MSBuild.Task.dll" Pack="true" PackagePath="tools\ILRepack.Lib.MSBuild.Task.dll" Visible="false" />
    <None Include="..\..\SDK\bin\$(Configuration)\$(TargetFramework)\ShiroBot.SDK.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\..\Models\Discord\bin\$(Configuration)\$(TargetFramework)\ShiroBot.Model.Discord.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\..\Models\QQ\bin\$(Configuration)\$(TargetFramework)\ShiroBot.Model.QQ.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\..\Models\Telegram\bin\$(Configuration)\$(TargetFramework)\ShiroBot.Model.Telegram.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
  </ItemGroup>

</Project>
