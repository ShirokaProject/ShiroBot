<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ShiroBot.Templates</PackageId>
    <Version>$(ShiroBotProductVersion)</Version>
    <PackageType>Template</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>ShiroBot project templates</Title>
    <Authors>ShirokaProject</Authors>
    <Description>dotnet new templates for creating ShiroBot plugins and adapters.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ShirokaProject/ShiroBot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShirokaProject/ShiroBot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet-new;templates;ShiroBot;plugin;adapter</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <!-- Generated projects need their dotfiles, including .gitignore. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- dev.ps1 is template content, not a NuGet installation script. -->
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.shirobot-dev\**;templates\**\.DS_Store" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Remove="templates\**\*.cs" />
  </ItemGroup>

  <!-- Generate package content without rewriting sources, even when packing skips the build. -->
  <Target Name="InjectTemplateSdkVersion" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_TemplateSdkVersionDir>$(IntermediateOutputPath)template-sdk-version</_TemplateSdkVersionDir>
    </PropertyGroup>
    <ItemGroup>
      <_TemplateSdkFile Include="templates/plugin/Directory.Packages.props" Kind="plugin" />
      <_TemplateSdkFile Include="templates/adapter/Directory.Packages.props" Kind="adapter" />
    </ItemGroup>
    <Copy SourceFiles="@(_TemplateSdkFile)"
          DestinationFiles="@(_TemplateSdkFile->'$(_TemplateSdkVersionDir)/%(Kind)/Directory.Packages.props')" />
    <XmlPoke XmlInputPath="$(_TemplateSdkVersionDir)/%(_TemplateSdkFile.Kind)/Directory.Packages.props"
             Query="/Project/ItemGroup/PackageVersion[@Include='ShiroBot.SDK']/@Version"
             Value="$(ShiroBotProductVersion)" />
    <ItemGroup>
      <Content Remove="@(Content)" Condition="'%(Content.Filename)%(Content.Extension)' == 'Directory.Packages.props'" />
      <Content Include="$(_TemplateSdkVersionDir)/plugin/Directory.Packages.props" PackagePath="content/templates/plugin/" />
      <Content Include="$(_TemplateSdkVersionDir)/adapter/Directory.Packages.props" PackagePath="content/templates/adapter/" />
    </ItemGroup>
  </Target>

</Project>
