<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ShiroBot.Templates</PackageId>
    <Version>0.9.0</Version>
    <PackageType>Template</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>ShiroBot project templates</Title>
    <Authors>ShirokaProject</Authors>
    <Description>dotnet new templates for creating ShiroBot plugins and adapters.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ShirokaProject/ShiroBot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShirokaProject/ShiroBot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet-new;templates;ShiroBot;plugin;adapter</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Remove="templates\**\*.cs" />
  </ItemGroup>

</Project>
