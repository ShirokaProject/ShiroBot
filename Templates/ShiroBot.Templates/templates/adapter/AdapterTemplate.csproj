<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ShiroBotPluginPackagingEnabled Condition="'$(Configuration)' == 'Release'">true</ShiroBotPluginPackagingEnabled>
    <!-- All bundled Models are host-provided, including ones this component does not use. -->
    <ShiroBotPluginSharedAssemblies>ShiroBot.Model.QQ;ShiroBot.Model.Discord;ShiroBot.Model.Telegram</ShiroBotPluginSharedAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ShiroBot.SDK" />
    <Compile Remove="TestPlugin/**/*.cs" />
    <!-- Build the test plugin for local development without linking it into the adapter. -->
    <ProjectReference Include="TestPlugin/AdapterTemplate.TestPlugin.csproj"
                      Condition="'$(Configuration)' == 'Debug'"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
