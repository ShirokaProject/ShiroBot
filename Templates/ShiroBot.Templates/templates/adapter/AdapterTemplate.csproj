<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ShiroBotPluginPackagingEnabled Condition="'$(Configuration)' == 'Release'">true</ShiroBotPluginPackagingEnabled>
    <!--#if (useQq)-->
    <ShiroBotPluginSharedAssemblies>ShiroBot.Model.QQ</ShiroBotPluginSharedAssemblies>
    <!--#endif-->
    <!--#if (useDiscord)-->
    <ShiroBotPluginSharedAssemblies>ShiroBot.Model.Discord</ShiroBotPluginSharedAssemblies>
    <!--#endif-->
    <!--#if (useTelegram)-->
    <ShiroBotPluginSharedAssemblies>ShiroBot.Model.Telegram</ShiroBotPluginSharedAssemblies>
    <!--#endif-->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ShiroBot.SDK" />
    <Compile Remove="TestPlugin/**/*.cs" />
    <!-- Build the test plugin for local development without linking it into the adapter. -->
    <ProjectReference Include="TestPlugin/AdapterTemplate.TestPlugin.csproj"
                      Condition="'$(Configuration)' == 'Debug'"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
