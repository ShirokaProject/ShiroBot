{
  "$schema": "http://json.schemastore.org/template",
  "author": "ShirokaProject",
  "classifications": [
    "ShiroBot",
    "Plugin",
    "Library"
  ],
  "identity": "ShirokaProject.ShiroBot.Templates.Plugin.CSharp",
  "name": "ShiroBot Plugin",
  "shortName": "shirobot-plugin",
  "description": "Creates a ShiroBot plugin with a working ping command.",
  "sourceName": "PluginTemplate",
  "defaultName": "MyShiroBotPlugin",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "creator": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Creator",
      "description": "Plugin author written to BotPlugin metadata.",
      "defaultValue": "Your Name",
      "replaces": "TemplateAuthor"
    },
    "pluginVersion": {
      "type": "parameter",
      "datatype": "string",
      "displayName": "Plugin version",
      "description": "Initial plugin version.",
      "defaultValue": "1.0.0",
      "replaces": "TemplateVersion"
    },
    "platform": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Platform model",
      "description": "Optional platform Model contract referenced by the plugin.",
      "defaultValue": "generic",
      "choices": [
        {
          "choice": "generic",
          "description": "Use only platform-neutral SDK contracts."
        },
        {
          "choice": "qq",
          "description": "Reference ShiroBot.Model.QQ."
        },
        {
          "choice": "discord",
          "description": "Reference ShiroBot.Model.Discord."
        },
        {
          "choice": "telegram",
          "description": "Reference ShiroBot.Model.Telegram."
        }
      ]
    },
    "useQq": {
      "type": "computed",
      "value": "(platform == \"qq\")"
    },
    "useDiscord": {
      "type": "computed",
      "value": "(platform == \"discord\")"
    },
    "useTelegram": {
      "type": "computed",
      "value": "(platform == \"telegram\")"
    },
    "operatingSystem": {
      "type": "bind",
      "binding": "env:OS",
      "defaultValue": "Unix"
    },
    "isWindows": {
      "type": "computed",
      "value": "(operatingSystem == \"Windows_NT\")"
    }
  },
  "primaryOutputs": [
    {
      "path": "PluginTemplate.csproj"
    }
  ],
  "postActions": [
    {
      "condition": "(operatingSystem != \"Windows_NT\")",
      "description": "Build the component and download its matching ShiroBot development host without starting it.",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "continueOnError": true,
      "args": {
        "executable": "/bin/sh",
        "args": "dev.sh --prepare",
        "redirectStandardOutput": false,
        "redirectStandardError": false
      },
      "manualInstructions": [
        {
          "text": "Run /bin/sh dev.sh --prepare, then select the ShiroBot profile in Rider and click Run."
        }
      ]
    },
    {
      "condition": "(operatingSystem == \"Windows_NT\")",
      "description": "Build the component and download its matching ShiroBot development host without starting it.",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "continueOnError": true,
      "args": {
        "executable": "powershell.exe",
        "args": "-NoProfile -ExecutionPolicy Bypass -File dev.ps1 --prepare",
        "redirectStandardOutput": false,
        "redirectStandardError": false
      },
      "manualInstructions": [
        {
          "text": "Run powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 --prepare, then select the ShiroBot profile in Rider and click Run."
        }
      ]
    }
  ],
  "sources": [
    {
      "modifiers": [
        {
          "condition": "isWindows",
          "exclude": [
            "Properties/launchSettings.Unix.json"
          ],
          "rename": {
            "Properties/launchSettings.Windows.json": "Properties/launchSettings.json"
          }
        },
        {
          "condition": "(!isWindows)",
          "exclude": [
            "Properties/launchSettings.Windows.json"
          ],
          "rename": {
            "Properties/launchSettings.Unix.json": "Properties/launchSettings.json"
          }
        }
      ]
    }
  ]
}
