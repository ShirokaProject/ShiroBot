<Project>
  <!-- Run and Debug use the same direct host launch profile; prepare its files during Debug builds. -->
  <Target Name="PrepareShiroBotDevelopmentHost" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
    <Exec Condition="'$(OS)' != 'Windows_NT'" WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="/bin/sh &quot;$(MSBuildProjectDirectory)/scripts/dev.sh&quot; --prepare --no-build" />
    <Exec Condition="'$(OS)' == 'Windows_NT'" WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/scripts/dev.ps1&quot; --prepare --no-build" />
  </Target>
</Project>
