<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="ShiroBotLocal" value="artifacts\packages" />
    <!-- ChsBuffer.Avalonia.AppHost from the ShiroBot fork of HostForge; eng/HostForge.targets downloads it. -->
    <add key="HostForge" value="eng/hostforge" />
  </packageSources>
  <disabledPackageSources>
    <add key="ShiroBotLocal" value="true" />
  </disabledPackageSources>
</configuration>
