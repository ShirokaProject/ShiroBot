<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ShiroBotPluginPackagingEnabled>true</ShiroBotPluginPackagingEnabled>
  </PropertyGroup>

  <!-- 只引用 SDK：两个示例插件之间没有共享程序集，也不互相引用。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\SDK\ShiroBot.SDK.csproj" Private="false" />
  </ItemGroup>

  <Import Project="..\..\..\SDK\buildTransitive\ShiroBot.SDK.props" />
  <Import Project="..\..\..\SDK\buildTransitive\ShiroBot.SDK.targets" />
</Project>
