<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Version>$(ShiroBotProductVersion)</Version>
        <InformationalVersion Condition="'$(ShiroBotStartupVersion)' != ''">$(ShiroBotStartupVersion)</InformationalVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Configurations>Debug;Release</Configurations>
        <SelfContained Condition="'$(SelfContained)'==''">false</SelfContained>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Dashboard 前端以成品 dist 形式从 Shirobot.Dashboard 仓的 Release 拉取，并嵌入宿主程序集。 -->
        <ShirobotDashboardVersion Condition="'$(ShirobotDashboardVersion)' == ''">$(ShiroBotProductVersion)</ShirobotDashboardVersion>
        <ShirobotDashboardRepo Condition="'$(ShirobotDashboardRepo)' == ''">ShirokaProject/Shirobot.Dashboard</ShirobotDashboardRepo>
        <ShirobotDashboardArchiveName>shirobot-dashboard-$(ShirobotDashboardVersion).zip</ShirobotDashboardArchiveName>
        <ShirobotDashboardDistUrl Condition="'$(ShirobotDashboardDistUrl)' == ''">https://github.com/$(ShirobotDashboardRepo)/releases/download/v$(ShirobotDashboardVersion)/$(ShirobotDashboardArchiveName)</ShirobotDashboardDistUrl>
        <ShirobotDashboardDistSha256 Condition="'$(ShirobotDashboardDistSha256)' == ''"></ShirobotDashboardDistSha256>

        <!-- 本地联调：指向本地 dashboard 仓的 dist 目录（含 index.html），跳过下载。 -->
        <DashboardDistPath Condition="'$(DashboardDistPath)' == ''"></DashboardDistPath>
        <!-- 成品落盘/嵌入目录，已被 .gitignore 忽略。 -->
        <DashboardAssetsDir Condition="'$(DashboardAssetsDir)' == ''">$(MSBuildProjectDirectory)/Assets/dashboard</DashboardAssetsDir>
        <!-- 发布流程置为 true：资源缺失时构建失败，避免发出一个没有面板的包。 -->
        <RequireDashboard Condition="'$(RequireDashboard)' == ''">false</RequireDashboard>

        <_DashboardResolvedDir Condition="'$(DashboardDistPath)' != '' and Exists('$(DashboardDistPath)/index.html')">$(DashboardDistPath)</_DashboardResolvedDir>
        <_DashboardResolvedDir Condition="'$(_DashboardResolvedDir)' == ''">$(DashboardAssetsDir)</_DashboardResolvedDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <!-- Keep Chinese satellites; English normally comes from neutral resources. -->
        <SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
        <PublishReadyToRun>false</PublishReadyToRun>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <DebuggerSupport>false</DebuggerSupport>
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
        <PackageReference Include="Avalonia.Skia" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Spectre.Console" />
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="Tomlyn" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ShiroBot.SelfContained</_Parameter1>
            <_Parameter2>$(SelfContained)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ShiroBot.RuntimeIdentifier</_Parameter1>
            <_Parameter2>$(RuntimeIdentifier)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <Target Name="AcquireDashboardAssets" BeforeTargets="PrepareForBuild">
        <PropertyGroup>
            <_DashboardStampFile>$(_DashboardResolvedDir)/.dashboard-version</_DashboardStampFile>
            <_DashboardCachedVersion Condition="Exists('$(_DashboardStampFile)')">$([System.IO.File]::ReadAllText('$(_DashboardStampFile)').Trim())</_DashboardCachedVersion>
            <!-- Re-acquire when the extract is missing or was produced by a different version. -->
            <_DashboardNeedsAcquire Condition="'$(DashboardDistPath)' == '' and !Exists('$(_DashboardResolvedDir)/index.html')">true</_DashboardNeedsAcquire>
            <_DashboardNeedsAcquire Condition="'$(DashboardDistPath)' == '' and '$(_DashboardCachedVersion)' != '$(ShirobotDashboardVersion)'">true</_DashboardNeedsAcquire>
        </PropertyGroup>

        <MakeDir Directories="$(IntermediateOutputPath)dashboard"
                 Condition="'$(_DashboardNeedsAcquire)' == 'true'" />

        <DownloadFile Condition="'$(_DashboardNeedsAcquire)' == 'true'"
                      SourceUrl="$(ShirobotDashboardDistUrl)"
                      DestinationFolder="$(IntermediateOutputPath)dashboard"
                      DestinationFileName="$(ShirobotDashboardArchiveName)"
                      ContinueOnError="true">
            <Output TaskParameter="DownloadedFile" PropertyName="_DashboardArchive" />
        </DownloadFile>

        <GetFileHash Condition="'$(_DashboardArchive)' != '' and '$(ShirobotDashboardDistSha256)' != ''"
                     Files="$(_DashboardArchive)"
                     Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_DashboardHashedArchive" />
        </GetFileHash>
        <PropertyGroup>
            <_DashboardArchiveHash>@(_DashboardHashedArchive->'%(FileHash)')</_DashboardArchiveHash>
        </PropertyGroup>
        <Error Condition="'$(_DashboardArchiveHash)' != '' and !$([System.String]::Equals('$(_DashboardArchiveHash)', '$(ShirobotDashboardDistSha256)', System.StringComparison.OrdinalIgnoreCase))"
               Text="Dashboard 成品校验失败：期望 $(ShirobotDashboardDistSha256)，实际 $(_DashboardArchiveHash)。" />

        <RemoveDir Directories="$(_DashboardResolvedDir)"
                   Condition="'$(_DashboardArchive)' != ''" />
        <Unzip Condition="'$(_DashboardArchive)' != ''"
               SourceFiles="$(_DashboardArchive)"
               DestinationFolder="$(_DashboardResolvedDir)" />
        <WriteLinesToFile Condition="'$(_DashboardArchive)' != '' and Exists('$(_DashboardResolvedDir)/index.html')"
                          File="$(_DashboardStampFile)"
                          Lines="$(ShirobotDashboardVersion)"
                          Overwrite="true" />

        <Error Condition="'$(RequireDashboard)' == 'true' and '$(DashboardDistPath)' == '' and '$(_DashboardNeedsAcquire)' == 'true' and '$(_DashboardArchive)' == ''"
               Text="无法获取 Dashboard v$(ShirobotDashboardVersion)，拒绝使用其他版本的缓存资源。" />
        <Error Condition="'$(RequireDashboard)' == 'true' and !Exists('$(_DashboardResolvedDir)/index.html')"
               Text="未获取到 Dashboard 资源：$(ShirobotDashboardDistUrl)。请先在 Shirobot.Dashboard 仓发布对应 tag 的 Release，或用 -p:DashboardDistPath=&lt;本地 dist 目录&gt; 指定。" />
        <Warning Condition="'$(RequireDashboard)' != 'true' and !Exists('$(_DashboardResolvedDir)/index.html')"
                 Text="未获取到 Dashboard 资源，/dashboard 将不可用：$(ShirobotDashboardDistUrl)" />

        <ItemGroup Condition="Exists('$(_DashboardResolvedDir)/index.html')">
            <_DashboardEmbeddedFile Include="$(_DashboardResolvedDir)/**/*" />
        </ItemGroup>
        <ItemGroup Condition="Exists('$(_DashboardResolvedDir)/index.html')">
            <EmbeddedResource Include="@(_DashboardEmbeddedFile)">
                <LogicalName>Assets.dashboard.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
            </EmbeddedResource>
        </ItemGroup>
    </Target>

    <Target Name="CopyDashboardAssetsToOutput"
            BeforeTargets="CopyFilesToOutputDirectory;CopyFilesToPublishDirectory"
            Condition="Exists('$(_DashboardResolvedDir)/index.html')">
        <ItemGroup>
            <_DashboardAssetFile Include="$(_DashboardResolvedDir)/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(_DashboardAssetFile)"
              DestinationFiles="@(_DashboardAssetFile->'$(OutDir)Assets/dashboard/%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\SDK\ShiroBot.SDK.csproj" />
        <ProjectReference Include="..\Models\Discord\ShiroBot.Model.Discord.csproj" />
        <ProjectReference Include="..\Models\QQ\ShiroBot.Model.QQ.csproj" />
        <ProjectReference Include="..\Models\Telegram\ShiroBot.Model.Telegram.csproj" />
    </ItemGroup>

</Project>
